{
  "name": "lms-lego",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "LMS Lego: a learning space a non-technical owner shapes and hands to any organization. See docs/01-PRODUCT-CONTRACT.md.",
  "scripts": {
    "test": "node --test",
    "test:unit": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/support/github-reporter.mjs --test-reporter-destination=stdout \"test/unit/*.test.ts\"",
    "test:at1": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/support/github-reporter.mjs --test-reporter-destination=stdout \"test/at1/*.test.ts\"",
    "test:at1:midnight": "LMS_TEST_CLOCK_START=23:59:58 node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/support/github-reporter.mjs --test-reporter-destination=stdout \"test/at1/*.test.ts\"",
    "test:at4": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/support/github-reporter.mjs --test-reporter-destination=stdout \"test/at4/*.test.ts\"",
    "test:at3": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/support/github-reporter.mjs --test-reporter-destination=stdout \"test/at3/*.test.ts\"",
    "test:at2": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/support/github-reporter.mjs --test-reporter-destination=stdout \"test/at2/*.test.ts\"",
    "test:at5": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/support/github-reporter.mjs --test-reporter-destination=stdout \"test/at5/*.test.ts\"",
    "test:at6": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/support/github-reporter.mjs --test-reporter-destination=stdout \"test/at6/*.test.ts\"",
    "test:at7": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/support/github-reporter.mjs --test-reporter-destination=stdout \"test/at7/*.test.ts\"",
    "test:guard:labels": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/support/github-reporter.mjs --test-reporter-destination=stdout test/guards/no-hardcoded-labels.test.ts",
    "test:guard:clock": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/support/github-reporter.mjs --test-reporter-destination=stdout test/guards/production-guard.test.ts",
    "test:guard:spaces": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/support/github-reporter.mjs --test-reporter-destination=stdout test/guards/space-isolation.test.ts",
    "test:guard:roles": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/support/github-reporter.mjs --test-reporter-destination=stdout test/guards/role-gates.test.ts",
    "test:guard:reset": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/support/github-reporter.mjs --test-reporter-destination=stdout test/guards/reset-links.test.ts",
    "test:guard:doors": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/support/github-reporter.mjs --test-reporter-destination=stdout test/guards/doors.test.ts",
    "test:guard:cross-origin": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/support/github-reporter.mjs --test-reporter-destination=stdout test/guards/cross-origin.test.ts",
    "test:guard:bounds": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/support/github-reporter.mjs --test-reporter-destination=stdout test/guards/bounds.test.ts",
    "test:guard:end-access": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/support/github-reporter.mjs --test-reporter-destination=stdout test/guards/end-access.test.ts",
    "test:guard:end-access-followups": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/support/github-reporter.mjs --test-reporter-destination=stdout test/guards/end-access-followups.test.ts test/unit/session-refresh.test.ts",
    "test:guard:unassign": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/support/github-reporter.mjs --test-reporter-destination=stdout test/guards/unassign.test.ts",
    "test:deploy-rails": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/support/github-reporter.mjs --test-reporter-destination=stdout test/guards/production-guard.test.ts test/deploy/workflow.test.ts test/deploy/migrations.test.ts test/deploy/smoke.test.ts",
    "test:last-resort": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/support/github-reporter.mjs --test-reporter-destination=stdout test/deploy/last-resort.test.ts",
    "test:password-strength": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/support/github-reporter.mjs --test-reporter-destination=stdout test/unit/password.test.ts test/unit/password-strength.test.ts test/password/strength.test.ts test/guards/production-guard.test.ts",
    "measure:password-cost": "node scripts/measure-password-cost.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler d1 migrations apply lms-lego --local && wrangler dev",
    "dev:test": "wrangler d1 migrations apply lms-lego --local --env test && wrangler dev --env test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261012.1",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "wrangler": "4.149.0"
  }
}
