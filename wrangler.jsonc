// LMS Lego Worker configuration.
// No account id, database id or secret lives here. On the first deploy the
// owner's Cloudflare account provisions the D1 database and the R2 bucket
// (Wrangler's automatic resource provisioning); see README "Deploy".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lms-lego",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Production build: the test hooks (controllable clock) are compiled out.
  "define": { "__TEST_HOOKS__": "false" },
  // Password strength in PBKDF2 iterations (README "Password strength").
  // The Worker accepts a whole number from 10000 to 100000 and refuses to
  // serve with anything else; absent means the code's default, 100000.
  // Owner decision 2 (docs/07-FIRST-DEPLOY.md): option B was taken on
  // 1 November 2026, so production runs at 10000, the floor, to fit a sign-in
  // inside the Workers Free plan's 10 ms of CPU. It is set before the first
  // deploy, so no 100000-iteration hash is ever written in production. Moving
  // to option A later means "100000" here and in the production guard's
  // DECIDED_ITERATIONS together; stored passwords are re-written at the new
  // value on their next sign-in. The production guard asserts this value.
  "vars": { "PASSWORD_ITERATIONS": "10000" },
  // Workers Logs (hardening task H-1; README "Logs"). On, so the product's own
  // log lines (src/log.ts: an event name and a scrubbed error, never a secret)
  // are kept for three days in the owner's account. Request logs
  // (invocation_logs) stay OFF: each would record the request's address, and a
  // reset link's token is part of its address (/r/<token>). Traces stay off.
  // Sampling 1 (every line): at most 2 product lines per request, so the free
  // plan's 100,000 requests a day give at most 200,000 lines, within the free
  // plan's 200,000 log events a day (0.5 GB a day from 1 December 2026; on
  // Free, Cloudflare stops keeping logs at the cap and charges nothing).
  // test/deploy/logs-config.test.ts asserts every value here.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "lms-lego", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "lms-lego-files" }],
  "env": {
    // Local and CI test runs only (`wrangler dev --env test`). Never deployed.
    // Vars are not inherited by an environment: without PASSWORD_ITERATIONS
    // here, tests run at the code's default, 100000, on purpose (build task 8,
    // README "Password strength"). Production's 10000 is proven by the
    // production guard and by the password-strength test of the production
    // build.
    "test": {
      "define": { "__TEST_HOOKS__": "true" },
      "vars": { "TEST_HOOKS": "1" },
      "d1_databases": [
        { "binding": "DB", "database_name": "lms-lego", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "lms-lego-files" }]
    }
  }
}
